{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlegeMasina catalog (public or demo)",
  "type": "object",
  "required": ["updated", "models"],
  "additionalProperties": false,
  "definitions": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "yearRange": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "to": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_title", "source_url", "retrieved_on", "license"],
      "additionalProperties": false,
      "properties": {
        "source_title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "retrieved_on": {
          "$ref": "#/definitions/date"
        },
        "license": {
          "$ref": "#/definitions/license"
        }
      }
    },
    "v2Sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/definitions/source"
      }
    },
    "opinion": {
      "type": "object",
      "required": ["text", "sources", "date"],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "$ref": "#/definitions/v2Sources"
        },
        "date": {
          "$ref": "#/definitions/date"
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["energy", "hp", "consumption"],
      "additionalProperties": false,
      "properties": {
        "energy": {
          "enum": ["benzina", "motorina", "gpl", "hibrid", "electric"]
        },
        "cc": {
          "type": "integer",
          "minimum": 500,
          "maximum": 8000
        },
        "hp": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1000
        },
        "consumption": {
          "type": "object",
          "required": ["value", "unit", "cycle"],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 40
            },
            "unit": {
              "enum": ["l/100km", "kWh/100km"]
            },
            "cycle": {
              "enum": ["NEDC", "WLTP", "unknown"]
            }
          }
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "updated": {
      "$ref": "#/definitions/date"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "brand",
          "model",
          "generation",
          "years",
          "body",
          "engines",
          "seats",
          "trunk_l",
          "sources",
          "verified",
          "is_demo"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "verified": {
            "type": "boolean"
          },
          "brand": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "string",
            "minLength": 1
          },
          "years": {
            "$ref": "#/definitions/yearRange"
          },
          "body": {
            "enum": ["hatchback", "sedan", "break", "suv", "mpv"]
          },
          "engines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/engine"
            }
          },
          "seats": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9
          },
          "trunk_l": {
            "type": "integer",
            "minimum": 50,
            "maximum": 3000
          },
          "price_eur": {
            "type": "object",
            "required": [
              "low",
              "high",
              "n_listings",
              "collected_on",
              "kind",
              "source_title",
              "source_url",
              "retrieved_on",
              "license",
              "verified",
              "is_demo"
            ],
            "additionalProperties": false,
            "properties": {
              "low": {
                "type": "integer",
                "minimum": 100
              },
              "high": {
                "type": "integer",
                "minimum": 100
              },
              "n_listings": {
                "type": ["integer", "null"],
                "minimum": 10
              },
              "collected_on": {
                "$ref": "#/definitions/date"
              },
              "kind": {
                "enum": ["asking_price", "synthetic"]
              },
              "notes": {
                "type": "string"
              },
              "source_title": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "retrieved_on": {
                "$ref": "#/definitions/date"
              },
              "license": {
                "$ref": "#/definitions/license"
              },
              "verified": {
                "type": "boolean"
              },
              "is_demo": {
                "type": "boolean"
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/source"
            }
          },
          "pros": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/opinion"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/opinion"
            }
          },
          "known_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "engines",
                "years",
                "severity",
                "sources",
                "date",
                "confidence"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "engines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "years": {
                  "$ref": "#/definitions/yearRange"
                },
                "severity": {
                  "enum": ["scazuta", "medie", "ridicata"]
                },
                "sources": {
                  "$ref": "#/definitions/v2Sources"
                },
                "date": {
                  "$ref": "#/definitions/date"
                },
                "confidence": {
                  "enum": ["scazuta", "medie", "ridicata"]
                }
              }
            }
          },
          "is_demo": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
