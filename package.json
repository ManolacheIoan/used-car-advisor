{
  "name": "alegemasina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "serve out -l 3000",
    "import:cars": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-cars.ts",
    "predev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/brand-assets.ts",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/brand-assets.ts",
    "build:demo-data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-demo.ts",
    "build:demo": "DATA_MODE=demo next build",
    "serve:demo": "serve out-demo -l 3000",
    "build:showcase": "DATA_MODE=demo SHOWCASE=1 next build",
    "serve:showcase": "serve out-showcase -l 3000",
    "fetch:wikidata": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-wikidata.ts",
    "build:demo-identities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-demo-identities.ts",
    "audit:public": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-public.ts",
    "report:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/coverage-report.ts",
    "check:links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-links.ts"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
