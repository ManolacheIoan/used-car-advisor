{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 1,
      "url": [
        "/",
        "/despre-date/",
        "/rezultate/?bmin=20000&bmax=60000&u=familie&f=oricare&c=oricare&s=5&km=12000",
        "/masini/exemplu-beta/"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(despre-date/)?$",
          "assertions": { "categories:seo": ["error", { "minScore": 0.9 }] }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
